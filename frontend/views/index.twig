   {% extends 'layout.twig' %}

   {% block body %}
   <!-- ======= Header ======= -->
   <header id="header">
       <div class="container">
            			<h1>
				<a href="#" title="Magnificent">Mou<span class="special" title="Youthful">Y</span>ahada I<span class="special" title="Youthful">sm</span>a<span class="special" title="Youthful">il</span>
				</a>
			</h1>

			<!-- Uncomment below if you prefer to use an image logo -->
			<!-- <a href="index.html" class="mr-auto"><img src="assets/img/logo.png" alt="" class="img-fluid"></a> -->
			<h2>Je suis un
				<span title="Concepteur et developpeur d'application" data-toggle="tooltip" data-placement="top" class="special-slim">{{ __('developer') }}</span>
				passioné, curieux et créatif</h2>

           <nav id="navbar" class="navbar">
               <ul>
                   <li><a class="nav-link active" href="#header">{{ __('home') }}</a></li>
                   <li><a class="nav-link" href="#about">{{ __('about') }}</a></li>
                   <li><a class="nav-link" href="#resume">{{ __('resume') }}</a></li>
                   <li><a class="nav-link" href="#services">{{ __('services') }}</a></li>
                   <li><a class="nav-link" href="#portfolio">{{ __('portfolio') }}</a></li>
                   <li><a class="nav-link" href="#contact">{{ __('contact') }}</a></li>
                   <li><a type="button" uk-toggle="target: +" class="nav-link" href="#video">Video</a></li>
               </ul>
               <i class="bi bi-list mobile-nav-toggle"></i>
           </nav>
           <!-- .navbar -->

           <div class="social-links">
               {% for item in reseaux.data %}
                   <a href="{{ item.lien }}" class="{{ item.icon }}">
                       <i class="bi bi-{{ item.icon }}"></i>
                   </a>
               {% endfor %}
           </div>
       </div>
   </header>
   <!-- End Header -->

   <!-- ======= About Section ======= -->
   <section id="about" class="about content">
       <div class="about-me container">
           <div class="section-title">
               <h2>{{ __('identity') }}</h2>
               <p>I.MOUYAHADA</p>
           </div>
           <div class="video-background"></div>
           <div class="row">
               <div class="col-lg-4 img-profil-container" data-aos="fade-right">
                   <img src="assets/img/me.png" class="img-fluid img-profil" alt=""/>
               </div>
               <div class="col-lg-8 pt-4 pt-lg-0 content" data-aos="fade-left">
                   <h3>{{ __('developer') }}</h3>
                   <p class="fst-italic">{{ acceuil.data.description_inrtoduction }}</p>
                   <div class="row">
                       <div class="col-lg-6">
                           <ul>
                               <li><i class="bi bi-chevron-right"></i><strong>{{ __('age') }}:</strong> <span>{{ acceuil.data.age }} ans</span></li>
                               <li><i class="bi bi-chevron-right"></i><strong>{{ __('freelance.available') }}</strong><span>{{ acceuil.data.disponibilite ? __('freelance.unavailable') : __('freelance.available') }}</span></li>
                           </ul>
                       </div>
                       <div class="col-lg-6">
                           <ul>
                               <li><i class="bi bi-chevron-right"></i><strong>{{ __('email') }}:</strong> <span>{{ acceuil.data.email }}</span></li>
                               <li><i class="bi bi-chevron-right"></i><strong>{{ __('phone') }}:</strong> <span>{{ acceuil.data.mobile }}</span></li>
                           </ul>
                       </div>
                   </div>
                   <p>{{ acceuil.data.description_profil }}</p>
               </div>
           </div>
       </div>
       <!-- End About Me -->

       <!-- ======= Testimonials ======= -->
       <div class="testimonials container">
           <div class="section-title">
               <h2>{{ __('testimonials') }}</h2>
           </div>
           <div class="testimonials-slider swiper" data-aos="fade-up" data-aos-delay="100">
               <div class="swiper-wrapper">
                   {% for item in temoignages.data %}
                       <div class="swiper-slide">
                           <div class="testimonial-item">
                               <p>
                                   <i class="bx bxs-quote-alt-left quote-icon-left"></i>
                                   {{ item.description }}
                                   <i class="bx bxs-quote-alt-right quote-icon-right"></i>
                               </p>
                               <img src="{{ assetPath }}{{ item.profil }}" class="testimonial-img" alt="{{ item.titre }}"/>
                               <h3>{{ item.titre }}</h3>
                               <h4>{{ item.titulaire }}</h4>
                           </div>
                       </div>
                   {% endfor %}
               </div>
               <div class="swiper-pagination"></div>
           </div>
       </div>
       <!-- End Testimonials -->
   </section>
   <!-- End About Section -->

   <!-- ======= Resume Section ======= -->
   <section id="resume" class="resume">
       <div class="container">
           <div class="section-title">
               <h2>{{ __('cv') }}</h2>
               <p>{{ __('consult_cv') }}</p>
           </div>
           <div class="row">
               <div class="col-lg-6">
                   <h3 class="resume-title">{{ __('resume') }}</h3>
                   <div class="resume-item pb-0">
                       <h4>{{ resumee.data.titulaire }}</h4>
                       <div>{{ resumee.data.description }}</div>
                   </div>
               </div>
               <div class="col-lg-6">
                   <h3 class="resume-title">{{ __('work_experience') }}</h3>
                   {% for item in experiences_professionnels.data %}
                       <div class="resume-item">
                           <h4>{{ item.titulaire }}</h4>
                           <h5 class="text-white">{{ item.peroide }}</h5>
                           <p><text>{{ item.site }}</text></p>
                           <div>{{ item.description }}</div>
                       </div>
                   {% endfor %}
               </div>
           </div>
       </div>
   </section>
   <!-- End Resume Section -->

   <!-- ======= Services Section ======= -->
   <section id="services" class="services">
       <div class="container">
           <div class="section-title">
               <h2>{{ __('services_title') }}</h2>
               <p>{{ __('services_description') }}</p>
           </div>
           <div class="row">
               {% for item in services.data %}
                   <div class="col-lg-4 col-md-6 d-flex align-items-stretch my-4 mt-md-0">
                       <div class="icon-box">
                           <div class="icon">
                               <i class="{{ item.icon }}"></i>
                           </div>
                           <h4><a href="">{{ item.titre }}</a></h4>
                           <p>{{ item.resumee }}</p>
                       </div>
                   </div>
               {% endfor %}
           </div>
       </div>
   </section>
   <!-- End Services Section -->

   <!-- ======= Portfolio Section ======= -->
   <section id="portfolio" class="portfolio">
       <div class="container">
           <div class="section-title">
               <h2>{{ __('portfolio_title') }}</h2>
               <p>{{ __('portfolio_description') }}</p>
           </div>
           <div class="row">
               <div class="col-lg-12 d-flex justify-content-center">
                   <ul id="portfolio-flters">
                       <li data-filter="*" class="filter-active">{{ __('all') }}</li>
                       <li data-filter=".filter-mobile">{{ __('mobile') }}</li>
                       <li data-filter=".filter-web">{{ __('web') }}</li>
                       <li data-filter=".filter-desktop">{{ __('desktop') }}</li>
                       <li data-filter=".filter-open-source">{{ __('open_source') }}</li>
                   </ul>
               </div>
           </div>
           <div class="row portfolio-container">
               {% for item in projects.data %}
                   <div class="col-lg-4 col-md-6 portfolio-item filter-{{ item.type }}">
                       <div class="portfolio-wrap">
                           <img src="{{ assetPath }}{{ item.screen }}" class="img-fluid" alt="{{ item.nom_projet }}"/>
                           <div class="portfolio-info">
                               <h4>{{ item.titre_projet }}</h4>
                               <p>{{ item.description }}</p>
                               <div class="portfolio-links">
                                   <a href="{{ item.link }}" title="{{ item.nom_projet }}"><i class="bx bx-plus"></i></a>
                                   <a href="/details/{{ item.id }}" title="Portfolio Details"><i class="bx bx-link"></i></a>
                               </div>
                           </div>
                       </div>
                   </div>
               {% endfor %}
           </div>
       </div>
   </section>
   <!-- End Portfolio Section -->

   <!-- ======= Contact Section ======= -->
   <section id="contact" class="contact">
       <div class="container">
           <div class="section-title">
               <h2>{{ __('contact_title') }}</h2>
               <p>{{ __('contact_description') }}</p>
           </div>
           <div class="row mt-2">
               <div class="col-md-6 d-flex align-items-stretch">
                   <div class="info-box">
                       <i class="bx bx-map"></i>
                       <h3>{{ __('location') }}</h3>
                       <p>{{ acceuil.data.ville }}</p>
                   </div>
               </div>
               <div class="col-md-6 mt-4 mt-md-0 d-flex align-items-stretch">
                   <div class="info-box">
                       <i class="bx bx-share-alt"></i>
                       <h3>{{ __('social_networks') }}</h3>
                       <div class="social-links">
                           {% for item in reseaux.data %}
                               <a href="{{ item.lien }}" class="{{ item.icon }}">
                                   <i class="bi bi-{{ item.icon }}"></i>
                               </a>
                           {% endfor %}
                       </div>
                   </div>
               </div>
               <div class="col-md-6 mt-4 d-flex align-items-stretch">
                   <div class="info-box">
                       <i class="bx bx-envelope"></i>
                       <h3>{{ __('email') }}</h3>
                       <p>{{ acceuil.data.email }}</p>
                   </div>
               </div>
               <div class="col-md-6 mt-4 d-flex align-items-stretch">
                   <div class="info-box">
                       <i class="bx bx-phone-call"></i>
                       <h3>{{ __('phone') }}</h3>
                       <p>{{ acceuil.data.mobile }}</p>
                   </div>
               </div>
           </div>
           <form action="/" method="post" role="form" class="php-email-form mt-4">
               <div class="row">
                   <div class="col-md-6 form-group">
                       <input type="text" name="nom" class="form-control" id="nom" placeholder="{{ __('name') }}" required/>
                   </div>
                   <div class="col-md-6 form-group mt-3 mt-md-0">
                       <input type="email" class="form-control" name="email" id="email" placeholder="{{ __('email') }}" required/>
                   </div>
               </div>
               <div class="form-group mt-3">
                   <input type="text" class="form-control" name="sujet" id="sujet" placeholder="{{ __('subject') }}" required/>
               </div>
               <div class="form-group mt-3">
                   <textarea class="form-control" name="message" rows="5" placeholder="{{ __('message') }}" required></textarea>
               </div>
               <div class="my-3">
                   <div class="loading">{{ __('loading') }}</div>
                   <div class="error-message"></div>
                   <div class="sent-message">{{ __('sent_message') }}</div>
               </div>
               <div class="text-center">
                   <button type="submit">{{ __('send_message') }}</button>
               </div>
           </form>
       </div>
   </section>
   <!-- End Contact Section -->

   <section id="video" class="about content">
       <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/uikit@3.21.1/dist/css/uikit.min.css"/>
       <div class="container">
           <div class="section-title">
               <h2>{{ __('video_intro') }}</h2>
           </div>
           <div class="row mt-2">
               <video src="/assets/media/intro.mp4" width="1920" height="1080" controls playsinline autoplay="false" uk-video></video>
           </div>
       </div>
   </section>

   <div class="credits">
       {{ __('rights_reserved') }} <a href="https://ismail-mouyahada.com/">ISMAIL MOUYAHADA</a>
   </div>
   {% endblock %}